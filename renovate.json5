{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Refresh poetry.lock (transitives, the lowerpines git ref) weekly.
    ":maintainLockFilesWeekly",
  ],
  // Updates open as soon as they clear minimumReleaseAge; only the lock
  // refresh above runs on a schedule (Monday mornings).
  timezone: "America/Chicago",

  // The Mend-hosted app injects mode: "silent" for repos installed under "All
  // repositories", which opens no PRs or dashboard issue. Pin it here so a
  // reinstall can't quietly put us back in silent mode.
  mode: "full",

  labels: ["dependencies"],

  // Give a release a few days to get yanked before we pick it up. Keep in step
  // with solver.min-release-age in poetry.toml, which covers lock maintenance.
  minimumReleaseAge: "3 days",

  // Lock maintenance re-resolves from scratch, and only Poetry >= 2.4 honours
  // solver.min-release-age; older versions silently ignore it. Without this,
  // Renovate runs whatever version the poetry.lock header names.
  constraints: {
    poetry: ">=2.4.0",
  },

  // Fixes for known vulnerabilities skip the release age.
  vulnerabilityAlerts: {
    labels: ["dependencies", "security"],
    minimumReleaseAge: null,
  },

  // A chart change without a version bump fails `ct lint`.
  helmv3: {
    bumpVersion: "patch",
  },

  customManagers: [
    {
      // The CI Python version lives in a workflow env var that no built-in
      // manager reads. Kept in step with the Dockerfile and .tool-versions by
      // the "python" group below.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\S+:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
    },
    {
      // POSTGRES_CEILING in tests/conftest.py: the newest PostgreSQL the
      // suite means to support. Same comment marker as above, but a Python
      // assignment rather than a YAML key. POSTGRES_DEFAULT sits beside it
      // with no marker on purpose -- it is a standing choice, not an
      // available version, so it moves by hand.
      customType: "regex",
      managerFilePatterns: ["/^tests/conftest\\.py$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+\\s*=\\s*(?<currentValue>\\d+)",
      ],
    },
  ],

  packageRules: [
    {
      // Type stubs track the framework release, so they have to move together
      // or mypy breaks.
      groupName: "django",
      matchPackageNames: ["django", "django-stubs", "django-stubs-ext"],
    },
    {
      groupName: "djangorestframework",
      matchPackageNames: ["djangorestframework", "djangorestframework-stubs"],
    },
    {
      groupName: "pylint",
      matchPackageNames: ["pylint", "pylint-django"],
    },
    {
      groupName: "pytest",
      matchPackageNames: ["pytest", "pytest-*", "dpytest"],
    },
    {
      // The interpreter shows up in the Dockerfile, .tool-versions and the CI
      // workflow; one PR keeps them from drifting apart. "none" keeps an
      // upgrade still inside minimumReleaseAge in the branch (behind a pending
      // stability check) instead of dropping it and opening a partial group.
      groupName: "python",
      matchDepNames: ["python"],
      internalChecksFilter: "none",
    },
    {
      // A floating Docker tag's timestamp is its last rebuild, not the Python
      // release, so it would hold the group every time the image is re-pushed.
      // The release age is already enforced on the .tool-versions upgrade.
      matchDatasources: ["docker"],
      matchDepNames: ["python"],
      minimumReleaseAge: null,
    },
    {
      groupName: "docker github actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["docker/*"],
    },
    {
      // CI no longer uses compose for the test database: the suite starts its
      // own containers, covering every major from Django's minimum up to
      // POSTGRES_CEILING in tests/conftest.py. This pin only affects local
      // `docker compose up`, where a major bump makes an existing dbdata
      // volume unreadable -- so it stays manual.
      matchManagers: ["docker-compose"],
      matchPackageNames: ["postgres"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      // POSTGRES_CEILING is the one PostgreSQL version meant to move on its
      // own: a new major should arrive as a PR whose CI says whether the
      // suite survives it, which is the entire point of the pin. So unlike
      // the two majors above it is deliberately ungated. Spelled out rather
      // than left to the default, because every other postgres major here is
      // held back and a later blanket rule should not quietly swallow this
      // one. POSTGRES_DEFAULT is invisible to Renovate -- it carries no
      // "# renovate:" marker -- so this is the only version it can bump.
      matchFileNames: ["tests/conftest.py"],
      matchPackageNames: ["postgres"],
      dependencyDashboardApproval: false,
    },
    {
      // Low-risk updates merge themselves once CI is green. Majors, runtime
      // dependencies and GitHub Actions (which run with the repo's secrets)
      // still wait for a human.
      matchDepTypes: ["dev"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
    },
  ],
}
